        "name": "Ckeck to Open Warning Modal",
        "func": "try { console.log('=== Subscription Plan Action Flow – Validation and Modal Trigger ==='); const input = msg?.payload?.apiRequestBody?.baseEntity?.records || []; if (input.length === 0) { throw new Error('No records found in the input data.'); } const data = input[0]; const planName = data['PLAN_NAME']; const currentPrice = parseFloat(data['PLAN_PRICE']) || 0; const previousPrice = parseFloat(data['TEMP_PLAN_PRICE']) || 0; console.log('PLAN_NAME:', planName); console.log('Current PLAN_PRICE:', currentPrice); console.log('Previous TEMP_PLAN_PRICE:', previousPrice); const isPriceChanged = currentPrice !== previousPrice; let Attri = msg.payload.apiRequestBody; console.log('Payload request body:', Attri); if (isPriceChanged) { console.log('Price changed — show confirmation modal.'); msg.payload['isOpenModal'] = true; } else { console.log('Price not changed — submitting form directly.'); msg.payload['isOpenModal'] = false; msg.payload.result = { formData: data }; } node.send(msg); } catch (error) { console.log('Error Occurred in Subscription Plan Action Flow:', error.message); console.log(error.stack); } return;",
